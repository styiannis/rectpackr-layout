{
  "name": "rectpackr-layout",
  "version": "1.1.0",
  "description": "Best-fit rectangle packing as a custom element: it measures its children, of any size, and packs them again as they resize, arrive or leave.",
  "keywords": [
    "custom-element",
    "custom-elements",
    "web-component",
    "web-components",
    "rectangle-packing",
    "best-fit",
    "strip-packing",
    "masonry",
    "masonry-layout",
    "responsive-layout",
    "layout",
    "typescript"
  ],
  "author": "Yiannis Stergiou <hello@styiannis.dev>",
  "license": "MIT",
  "homepage": "https://github.com/styiannis/rectpackr-layout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styiannis/rectpackr-layout.git"
  },
  "bugs": {
    "url": "https://github.com/styiannis/rectpackr-layout/issues"
  },
  "type": "commonjs",
  "source": "src/index.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/es/index.mjs",
  "types": "dist/@types/cjs/index.d.cts",
  "unpkg": "dist/umd/index.js",
  "jsdelivr": "dist/umd/index.js",
  "customElements": "dist/custom-elements.json",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=8.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "warn"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "analyze": "cem analyze --globs \"dist/es/**/*.mjs\" --outdir ./dist",
    "build": "node ./scripts/clear.cjs ./dist && rollup -c && npm run analyze",
    "dev": "node ./scripts/clear.cjs ./dist && rollup -c --watch",
    "check-declared-paths": "node ./scripts/check-declared-paths.cjs",
    "check-dist-loads": "node ./scripts/check-dist-loads.cjs",
    "check-types": "tsc --noEmit",
    "check-updates": "npx npm-check-updates@23",
    "clear": "node ./scripts/clear.cjs ./build ./code_documentation ./coverage_report ./dist",
    "format": "prettier -w ./",
    "lint": "oxlint --deny-warnings src scripts",
    "prepack": "npm i && npm run build",
    "reset": "npm run clear && node ./scripts/clear.cjs ./node_modules",
    "reset-hard": "npm run reset && node ./scripts/clear.cjs ./package-lock.json ./yarn.lock ./pnpm-lock.yaml",
    "test": "jest",
    "test-coverage": "node ./scripts/clear.cjs ./coverage_report && jest --coverage --coverageDirectory=coverage_report",
    "test-coverage-watch": "npm run test-coverage -- --watchAll",
    "test-watch": "jest --watchAll",
    "verify": "npm run check-types && npm run lint && npm run build && npm run check-declared-paths && npm run check-dist-loads"
  },
  "dependencies": {
    "best-fit-strip-pack": "^1.1.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^28.1.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/@types/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/@types/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
