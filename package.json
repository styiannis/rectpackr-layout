{
  "name": "rectpackr-layout",
  "version": "1.0.1",
  "description": "A web component that creates layouts by packing HTML elements as rectangles using a best-fit 2D strip-packing algorithm. Automatically measures dimensions and handles mixed content.",
  "keywords": [
    "best-fit",
    "custom-element",
    "custom-elements",
    "dom",
    "layout",
    "masonry",
    "masonry-layout",
    "responsive",
    "responsive-layout",
    "rectangle-packing",
    "strip-packing",
    "web-component",
    "web-components"
  ],
  "author": "Yiannis Stergiou <hello@styiannis.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styiannis/rectpackr-layout.git"
  },
  "bugs": {
    "url": "https://github.com/styiannis/rectpackr-layout/issues"
  },
  "source": "src/index.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "unpkg": "dist/umd/index.js",
  "jsdelivr": "dist/umd/index.js",
  "types": "dist/@types/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "build": "node ./scripts/clear.cjs ./dist && rollup -c",
    "dev": "node ./scripts/clear.cjs ./dist && rollup -c --watch",
    "check-declared-paths": "node ./scripts/check-declared-paths.cjs",
    "check-types": "tsc --noEmit",
    "check-updates": "npx npm-check-updates@23",
    "clear": "node ./scripts/clear.cjs ./build ./code_documentation ./coverage_report ./dist",
    "format": "prettier -w ./",
    "lint": "oxlint --deny-warnings src scripts",
    "prepack": "npm i && npm run build",
    "reset": "npm run clear && node ./scripts/clear.cjs ./node_modules",
    "reset-hard": "npm run reset && node ./scripts/clear.cjs ./package-lock.json ./yarn.lock ./pnpm-lock.yaml",
    "test": "jest",
    "test-coverage": "node ./scripts/clear.cjs ./coverage_report && jest --coverage --coverageDirectory=coverage_report",
    "test-coverage-watch": "npm run test-coverage -- --watchAll",
    "test-watch": "jest --watchAll",
    "verify": "npm run check-types && npm run lint && npm run build && npm run check-declared-paths"
  },
  "dependencies": {
    "best-fit-strip-pack": "^1.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "oxlint": "^1.81.0",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.3.0",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/@types/index.d.ts",
      "default": "./dist/es/index.js"
    }
  }
}
